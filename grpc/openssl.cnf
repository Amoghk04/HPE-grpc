[ req ]
default_bits        = 2048
default_md          = sha256
default_keyfile     = server.key
prompt              = no
encrypt_key         = no

distinguished_name  = req_distinguished_name

[ req_distinguished_name ]
C                   = US
ST                  = California
L                   = San Francisco
O                   = My Company
OU                  = My Division
CN                  = localhost