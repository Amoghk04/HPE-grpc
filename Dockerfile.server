# Dockerfile.server
# Build stage
FROM ubuntu:22.04 AS builder

# Install build dependencies for gRPC, Protobuf, and JSON
RUN apt-get update && apt-get install -y \
    build-essential \
    g++ \
    autoconf \
    libtool \
    git \
    cmake \
    pkg-config \
    libssl-dev \
    libprotobuf-dev \
    protobuf-compiler \
    libgrpc++-dev \
    nlohmann-json3-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone and build gRPC
RUN git clone --recurse-submodules -b v1.70.1 https://github.com/grpc/grpc && \
    cd grpc && \
    mkdir -p cmake/build && cd cmake/build && \
    cmake -DgRPC_INSTALL=ON \
          -DgRPC_BUILD_TESTS=OFF \
          -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_SHARED_LIBS=ON \
          ../.. && \
    make -j$(nproc) && make install

# Setup working directory and copy the project source
WORKDIR /app
ENV LD_LIBRARY_PATH=/usr/local/lib
COPY . .

# Copy the configuration file into the image (adjust path if necessary)
COPY grpc/config.json /app/config.json

# Generate server protobuf and gRPC source files
RUN protoc --proto_path=grpc/ --cpp_out=grpc/ --grpc_out=grpc/ \
       --plugin=protoc-gen-grpc=$(which grpc_cpp_plugin) grpc/service.proto

# Build the server executable with C++17 enabled
RUN rm -rf grpc/build && mkdir -p grpc/build && cd grpc/build && \
    mkdir -p uploads && cmake -DCMAKE_CXX_STANDARD=17 .. && make -j$(nproc)

# Runtime stage
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y libssl-dev && rm -rf /var/lib/apt/lists/*

# Copy gRPC libraries from builder
COPY --from=builder /usr/local/lib /usr/local/lib
ENV LD_LIBRARY_PATH=/usr/local/lib

WORKDIR /app

# Copy the server executable, configuration and SSL certificate files
COPY --from=builder /app/grpc/build/server /app/grpc/build/server
COPY --from=builder /app/certs/ca.crt /app/certs/ca.crt
COPY --from=builder /app/certs/server.crt /app/certs/server.crt
COPY --from=builder /app/certs/server.key /app/certs/server.key
COPY --from=builder /app/config.json /app/grpc/config.json

EXPOSE 50051

WORKDIR /app/grpc/build 
CMD ["/app/grpc/build/server"]